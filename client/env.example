# Copy to .env.development / .env.staging / .env.production as needed.
# Only REACT_APP_* vars are exposed to the browser (CRA convention).

# Backend API base URL (per environment)
REACT_APP_API_URL=http://localhost:5000/api

# Google OAuth Configuration
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id_here

# Supabase (legacy — still used by the current UI until the API refactor lands)
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key
