# ---------------------------------------------------------------------------
# Backend environment template. Copy to .env.<environment> and fill in values.
# NEVER commit the filled-in files — they contain the live DB password.
# Supported NODE_ENV values: development | staging | production
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# Allowed CORS origin for the React client (comma-separated for multiple).
CLIENT_ORIGIN=http://localhost:3000

# Postgres connection. The DB (gamingdronzz_cachedinfo) runs loopback-only on
# the DigitalOcean droplet. Two ways to reach it:
#
#   Remote dev  -> open an SSH tunnel (local 5433 -> droplet 5432) and connect
#                  to 127.0.0.1:5433. See gamingdronzz_cachedinfo.md.
#   On droplet  -> connect directly to 127.0.0.1:5432.
#
# There are TWO independent databases — production and staging — each with its
# own role/password. Point staging work at the *_staging DB, never at prod.
#
# Prefer a single DATABASE_URL:
#   Production: DATABASE_URL=postgresql://gamingdronzz_cachedinfo:<DB_PASSWORD>@127.0.0.1:5433/gamingdronzz_cachedinfo
#   Staging:    DATABASE_URL=postgresql://gamingdronzz_cachedinfo_staging:<STAGING_DB_PASSWORD>@127.0.0.1:5433/gamingdronzz_cachedinfo_staging
DATABASE_URL=postgresql://gamingdronzz_cachedinfo:<DB_PASSWORD>@127.0.0.1:5433/gamingdronzz_cachedinfo

# ...or discrete fields (used only if DATABASE_URL is unset):
# PGHOST=127.0.0.1
# PGPORT=5433
# PGUSER=gamingdronzz_cachedinfo
# PGPASSWORD=<DB_PASSWORD>
# PGDATABASE=gamingdronzz_cachedinfo

# ---------------------------------------------------------------------------
# Auth — JSON Web Tokens
# ---------------------------------------------------------------------------
# Secret used to sign short-lived access tokens. Generate a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=<RANDOM_LONG_SECRET>
# Access token lifetime (e.g. 15m, 1h). Refresh token lifetime is in days.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# Name of the httpOnly cookie that stores the refresh token.
REFRESH_COOKIE_NAME=cinfo_rt

# ---------------------------------------------------------------------------
# Auth — Google OAuth (backend-driven via Passport)
# Create credentials at https://console.cloud.google.com/ and register the
# callback URL below as an authorized redirect URI.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>
# Must match Google Cloud Console exactly. Per environment:
#   dev:     http://localhost:5000/api/auth/google/callback
#   staging: https://staging.cachedinfo.gamingdronzz.com/api/auth/google/callback
#   prod:    https://cachedinfo.gamingdronzz.com/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Email granted the management role when running `npm run seed` (bootstrap).
BOOTSTRAP_ADMIN_EMAIL=you@example.com
